#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]
(
    address: "$XDG_RUNTIME_DIR/mpd/socket",
    password: None,
    theme: "unnatural",
    cache_dir: "$HOME/Music/new",
    lyrics_dir: "$HOME/Music/lyrics",
    on_song_change: None,
    volume_step: 5,
    max_fps: 30,
    scrolloff: 0,
    wrap_navigation: false,
    enable_mouse: true,
    scroll_amount: 1,
    enable_config_hot_reload: true,
    enable_lyrics_hot_reload: false,
    status_update_interval_ms: 1000,
    rewind_to_start_sec: 5,
    keep_state_on_song_change: true,
    reflect_changes_to_playlist: false,
    select_current_song_on_change: false,
    ignore_leading_the: false,
    browser_song_sort: [Disc, Track, Artist, Title],
    directories_sort: SortFormat(group_by_type: true, reverse: false),
    auto_open_downloads: true,
    extra_yt_dlp_args: ["--yt-music", "--no-progress"],
    queue_disable_current_item_style_timeout_ms: 10000, // 10s
    album_art: (
        method: Auto,
        order: EmbeddedFirst,
        max_size_px: (width: 1200, height: 1200),
        disabled_protocols: ["http://", "https://"],
        vertical_align: Center,
        horizontal_align: Center,
    ),

    keybinds: (
        clear: true,
        global: {
            "q":       Quit,
            "~":       ShowHelp,
            "?":       ShowHelp,
            ":":       CommandMode,
            "I":       ShowCurrentSongInfo,
            "o":       ShowOutputs,
            "w":       ShowDownloads,
            "z":       ToggleRepeat,
            "x":       ToggleRandom,
            "c":       ToggleConsume,
            "v":       ToggleSingle,
            "p":       TogglePause,
            "<Space>": TogglePause,
            "s":       Stop,
            ">":       NextTrack,
            "<":       PreviousTrack,
            "f":       SeekForward,
            "b":       SeekBack,
            ".":       VolumeUp,
            ",":       VolumeDown,
            "<Tab>":   NextTab,
            "<S-Tab>": PreviousTab,
            "1":       SwitchToTab("Cava"),
            "2":       SwitchToTab("Queue"),
            "3":       SwitchToTab("Folders"),
            "4":       SwitchToTab("Playlists"),
            "5":       SwitchToTab("Search"),
            "6":       SwitchToTab("Lyrics"),
            "<u>":   Update,
            "<U>":   Rescan,
        },
        navigation: {
            "<C-c>":        Close,
            "<Esc>":        Close,
            "<CR>":         Confirm,
            "<Up>":         Up,
            "<Down>":       Down,
            "<Left>":       Left,
            "<Right>":      Right,
            "<C-Up>":       MoveUp,
            "<C-Down>":     MoveDown,
            "<A-Up>":       PaneUp,
            "<A-Down>":     PaneDown,
            "<A-Left>":     PaneLeft,
            "<A-Right>":    PaneRight,
            "<PageUp>":     PageUp,
            "<PageDown>":   PageDown,
            "<S-Down>":     Select,
            "<S-Up>":       SelectUp,
            "<C-Space>":    InvertSelection,
            "/":            EnterSearch,
            "n":            NextResult,
            "N":            PreviousResult,
            "a":            Add,
            "A":            AddAll,
            "D":            Delete,
            "r":            Rename,
            "i":            FocusInput,
            "I":            ShowInfo,
            "<C-z>":        ContextMenu(),
            "<C-s>":        Save(kind: Modal(all: false, duplicates_strategy: Ask)),
            "<C-S>":        Save(kind: Modal(all: true, duplicates_strategy: Ask)),
            "R":            Rate(),
            "<C-c>":        CopyToClipboard(kind: Modal([
                                ("Displayed value", (content: DisplayedValue, all: false)),
                                ("Artist - Title", (content: Metadata([(kind: Property(Artist)), (kind: Text(" - ")), (kind: Property(Title))]), all: false)),
                                ("File Path", (content: Metadata([(kind: Text("~/Music/")), (kind: Property(File))]), all: false)),
                            ])),
        },
        queue: {
            "d":     Delete,
            "D":     DeleteAll,
            "<CR>":  Play,
            "C":     JumpToCurrent,
            "X":     Shuffle,
        },
    ),

    search: (
        case_sensitive: false,
        ignore_diacritics: false,
        search_button: false,
        mode: Contains,
        tags: [
            (value: "any",         label: "Any Tag"),
            (value: "title",       label: "Title"),
            (value: "filename",    label: "Filename"),
            (value: "artist",      label: "Artist"),
            (value: "album",       label: "Album"),
            (value: "albumartist", label: "Album Artist"),
            (value: "genre",       label: "Genre"),
        ],
    ),

    artists: (
        album_display_mode: SplitByDate,
        album_sort_by: Date,
        album_date_tags: [Date],
    ),

    cava: (
        framerate: 60, // default 60
        autosens: true, // default true
        sensitivity: 100, // default 100
        lower_cutoff_freq: 50, // not passed to cava if not provided
        higher_cutoff_freq: 10000, // not passed to cava if not provided
        input: (
            method: Fifo,
            source: "/tmp/mpd.fifo",
            sample_rate: 44100,
            channels: 2,
            sample_bits: 16,
        ),
        smoothing: (
            noise_reduction: 77, // default 77
            monstercat: false, // default false
            waves: false, // default false
        ),
        // this is a list of floating point numbers thats directly passed to cava
        // they are passed in order that they are defined
        eq: []
    ),

    tabs: [
        (
            name: "Cava",
            pane: Split(
                direction: Horizontal,
                panes: [
                    (pane: Pane(AlbumArt), size: "35%"),
                    (pane: Pane(Cava), size: "65%")
                ]
            )
        ),
        (
            name: "Queue",
            pane: Split(
                direction: Horizontal,
                panes: [
                    (pane: Split(
                        direction: Vertical,
                            panes: [
                                (pane: Pane(AlbumArt), size: "20", borders: "RIGHT", border_symbols: Rounded),
                                (pane: Pane(Cava), size: "100%", borders: "RIGHT", border_symbols: Rounded),
                            ]
                        ),
                        size: "35%"
                    ),
                    (pane: Pane(Queue), size: "65%")
                ]
            )
        ),
        (
            name: "Folders",
            pane: Pane(Directories)
        ),
        (
            name: "Playlists",
            pane: Pane(Playlists)
        ),
        (
            name: "Search",
            pane: Pane(Search)
        ),
        (
            name: "Lyrics",
            pane: Pane(Lyrics)
        ),
    ],
)
