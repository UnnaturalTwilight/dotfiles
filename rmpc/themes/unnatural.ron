#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]
(
    draw_borders: true,
    //default_album_art_path: None,
    format_tag_separator: " | ",
    browser_column_widths: [25, 45, 30],
    background_color: None,
    text_color: "white",
    header_background_color: None,
    modal_background_color: None,
    modal_backdrop: false,
    preview_label_style: (fg: "#81a1c1", modifiers: "Italic"),
    preview_metadata_group_style: (fg: "#a3be8c", modifiers: "Bold"),
    current_item_style: (fg: "white", bg: "#5f5faf", modifiers: "Bold"),
    highlighted_item_style: (fg: "#d7afff", bg: "black", modifiers: "Bold"),
    borders_style: (fg: "dark_gray", modifiers: "Bold"),
    highlight_border_style: (fg: "dark_gray"),

    symbols: (song: "󰝚 ", dir: " ", playlist: "󰲸", marker: "⯈", ellipsis: "...",
        song_style: None, dir_style: (fg: "#86bbd8"), playlist_style: (fg: "#a3be8c")),
    progress_bar: (
        symbols: ["▐", "█", "┃", "█", "▌"],
        track_style: (fg: "black"),
        elapsed_style: (fg: "#5f5faf"),
        thumb_style: (fg: "#875fff"),
        use_track_when_empty: false,
    ),
    scrollbar: (
        symbols: ["│", "█", "▲", "▼"],
        track_style: (fg: "dark_gray"),
        ends_style: (fg: "gray"),
        thumb_style: (fg: "#5f5faf", modifiers: "Bold"),
    ),
    
    tab_bar: (
        active_style: (fg: "white", bg: "#5f5faf", modifiers: "Bold"),
        inactive_style: (fg: "gray", modifiers: ""),
    ),

    browser_song_format: [
        (
            kind: Group([
                (kind: Property(Track)),
                (kind: Text(" ")),
            ])
        ),
        (
            kind: Group([
                (kind: Property(Title)),
                (kind: Text(" - ")),
                (kind: Property(Artist)),
            ]),
            default: (kind: Property(Filename))
        ),
    ],
    
    song_table_format: [
        (
            prop: (kind: Text("")),
            width: "1",
        ),
        (
            prop: (kind: Property(Title), style: (fg: "gray"),
                highlighted_item_style: (fg: "black", modifiers: "Bold"),
                default: (kind: Property(Filename), style: (fg: "gray"),)
            ),
            width: "70%",
        ),
        (
            prop: (kind: Property(Album), style: (fg: "gray", modifiers: "Bold"),
                default: (kind: Text("Unknown Album"), style: (fg: "dark_gray"))
            ),
            width: "30%",
        ),
        (
            prop: (kind: Property(Duration),
                default: (kind: Text("-:--"))
            ),
            width: "5",
            alignment: Right,
        ),
        (
            prop: (kind: Text("")),
            width: "0",
        ),
    ],

    layout: Split(
        direction: Vertical,
        panes: [
            (
                pane: Component("header"),
                borders: "ALL",
                border_symbols: Rounded,
                size: "4",
            ),
            (
                pane: Pane(Tabs),
                borders: "RIGHT | LEFT | TOP",
                border_symbols: Rounded,
                size: "2",
            ),
            (
                pane: Pane(TabContent),
                size: "100%",
            ),
            (
                size: "3",
                borders: "ALL",
                border_symbols: Rounded,
                border_title: [
                    (kind: Text(" "),style: (fg: "dark_gray")),
                    (kind: Property(Status(Elapsed)),style: (fg: "dark_gray")),
                    (kind: Text("/"),style: (fg: "dark_gray")),
                    (kind: Property(Status(Duration)),style: (fg: "dark_gray")),
                    (kind: Text(" ─"),style: (fg: "dark_gray"))],
                border_title_alignment: Right,
                pane: Pane(ProgressBar)
            ),
        ],
    ),
    
    components: {
        "_playpause1": Pane(Property(
            content: [
                (kind: Property(Status(StateV2(playing_label: " 🬦🬓🬦🬓 ", paused_label: "  🭑🬽  ", stopped_label: " 🬦🬹🬹🬓 "))), 
                style: (fg: "#875fff", modifiers: "Bold")),
            ], align: Left,
        )),
        "_playpause2": Pane(Property(
            content: [
                (kind: Property(Status(StateV2(playing_label: " 🬉🬄🬉🬄 ", paused_label: "  🭜🭘  ", stopped_label: " 🬉🬎🬎🬄" ))), 
                style: (fg: "#875fff", modifiers: "Bold")),
            ], align: Left,
        )),
        "_mode1" : Pane(Property(
            content: [
                (kind: Property(Status(RepeatV2(
                    on_label: "  ", off_label: "  ",
                    on_style: (fg: "#875fff", modifiers: "Bold"),
                    off_style: (fg: "gray", modifiers: "Bold")))
                )),
                (kind: Property(Status(RandomV2(
                    on_label: "  ", off_label: "  ",
                    on_style: (fg: "#875fff", modifiers: "Bold"),
                    off_style: (fg: "gray", modifiers: "Bold")))
                )),
            ], align: Left,
        )),
        "_mode2" : Pane(Property(
            content: [
                (kind: Property(Status(ConsumeV2(
                    on_label: " 󰅗 ", off_label: " 󱟃 ", oneshot_label: " 󰍵 ",
                    on_style: (fg: "#875fff", modifiers: "Bold"),
                    off_style: (fg: "gray", modifiers: "Bold"),
                    oneshot_style: (fg: "#5f5faf", modifiers: "Bold")))
                )),
                (kind: Property(Status(SingleV2(
                    on_label: "  ", off_label: " 󰒉 ", oneshot_label: " 󰎤 ",
                    on_style: (fg: "#875fff", modifiers: "Bold"),
                    off_style: (fg: "gray", modifiers: "Bold"),
                    oneshot_style: (fg: "#5f5faf", modifiers: "Bold")))
                )),
            ], align: Left,
        )),
        "state": Split(
            direction: Horizontal,
            panes: [
                (size: "6", pane: Split(
                    direction: Vertical,
                    panes: [
                        (size: "1", pane: Component("_playpause1")),
                        (size: "1", pane: Component("_playpause2")),
                    ],
                )),
                (size: "9", pane: Split(
                    direction: Vertical,
                    borders: "LEFT | RIGHT",
                    panes: [
                        (size: "1", pane: Component("_mode1")),
                        (size: "1", pane: Component("_mode2")),
                    ],
                )),
            ]
        ),
        "title": Pane(Property(
            content: [
                (kind: Property(Song(Title)), style: (fg: "white", modifiers: "Bold"),
                    default: (kind: Property(Song(Filename)), style: (fg: "white", modifiers: "Bold"), default:(kind: Text("No Song"))))
            ], align: Center, scroll_speed: 1
        )),
        "subtitle": Pane(Property(
            content: [
                (kind: Property(Song(Artist)), style: (fg: "gray"),
                    default: (kind: Text("Unknown Artist"), style: (fg: "dark_gray"))),
            ], align: Center, scroll_speed: 1
        )),
        "song": Split(
            direction: Vertical,
            panes: [
                (size: "1", pane: Component("title")),
                (size: "1", pane: Component("subtitle")),
            ],
        ),
        "volumeBar": Split(
            direction: Horizontal,
            panes: [
                (size: "3", pane: Pane(Property(content: [(kind: Text(" 󰕾 "),style: (fg: "gray", modifiers: "Bold"))]))),
                (size: "11", pane: Pane(Volume(
                    kind: Slider(
                        symbols: (start: "╺", filled: "━", thumb: "●", track: "━", end: "╸",),
                        track_style: (fg: "dark_gray"), filled_style: (fg: "#875fff"), thumb_style: (fg: "gray"),
                )))),
            ],
        ),
        "volumeLabel": Pane(Property(
            content: [
                (kind: Property(Status(Volume)), style: (fg: "gray", modifiers: "Bold")),
                (kind: Text("% "), style: (fg: "gray", modifiers: "Bold"))
            ], align: Right
        )),
        "volume": Split(
            direction: Horizontal,
            panes: [
                (size: "1", pane: Pane(Empty())),
                (size: "15", pane: Split(
                    direction: Vertical,
                    borders: "LEFT",
                    panes: [
                        (size: "1", pane: Component("volumeLabel")),
                        (size: "1", pane: Component("volumeBar")),
                    ],
                )),
            ]
        ),
        "header": Split(
            direction: Horizontal,
            panes: [
                (size: "16", pane: Component("state")),
                (size: "100%", pane: Component("song")),
                (size: "16", pane: Component("volume")),
            ],
        ),
    },
    
    cava: (
        // symbols that will be used to draw the bar in the visualiser, in ascending order of fill fraction
        bar_symbols: ['▁', '▂', '▃', '▄', '▅', '▆', '▇', '█'],
        // similar to bar_symbols but these are used for the top-down rendering, meaning for orientation "Horizontal" and "Top"
        inverted_bar_symbols: ['▔', '🮂', '🮃', '▀', '🮄', '🮅', '🮆', '█'],

        bar_width: 2, // width of a single bar in columns
        bar_spacing: 1, // free space between bars in columns
    
        // Possible values are "Top", "Bottom" and "Horizontal".
        orientation: Horizontal,
    
        // A simple color gradient. This is a map where keys are percent values of the height
        // where the color starts. After that it is linearly interpolated towards the next value.
        // In this example, the color will start at green for the lowest amplitudes, go towards
        // blue at half amplitudes and finishing as red for the highest values. Keys must be between
        // 0 and 100 and if the first or last key are not 0 and 100 respectively, the lowest and highest
        // value will be used as 0 and 100. Only hex and RGB colors are supported here and your terminal
        // must support them as well!
        bar_color: Gradient({
            100: "#df75ff",
            000: "#6a5bcd"
        })
    ),
)
