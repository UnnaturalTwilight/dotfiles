// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "unbind": {
      "ctrl-q": "zed::Quit",
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-shift-space": "command_palette::Toggle",
    },
    "unbind": {
      "ctrl-w": "workspace::CloseActiveDock",
      "ctrl-shift-p": "command_palette::Toggle",
    },
  },
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-shift-enter": "pane::SplitRight",
      "ctrl-shift-q": ["pane::CloseActiveItem", { "close_pinned": false }],
    },
    "unbind": {
      "ctrl-shift-5": "pane::SplitRight",
      "ctrl-shift-space": "terminal::ToggleViMode",
      "ctrl-shift-c": "collab_panel::ToggleFocus",
    },
  },
  {
    "context": "Editor",
    "bindings": {
      "ctrl-shift-enter": "pane::SplitRight",
      "ctrl-shift-c": "editor::Copy",
      "ctrl-shift-v": "editor::Paste",
      "ctrl-q": ["pane::CloseActiveItem", { "close_pinned": false }],
      "alt-shift-space": "editor::ShowWordCompletions",
    },
    "unbind": {
      "ctrl-\\": "pane::SplitRight",
      "ctrl-shift-space": "editor::ShowSignatureHelp",
    },
  },
  {
    // This is needed to facilitate unbinding multiple actions from the same key combo
    "context": "Editor",
    "unbind": {
      "ctrl-shift-space": "editor::ShowWordCompletions",
    },
  },
  {
    "context": "Editor && mode == full",
    "unbind": {
      "ctrl-shift-enter": "editor::NewlineAbove",
    },
  },
  {
    "context": "Editor && mode == auto_height",
    "unbind": {
      "ctrl-shift-enter": "editor::NewlineBelow",
    },
  },
  {
    "context": "Editor && extension == svg",
    "unbind": {
      "ctrl-shift-v": "svg::OpenPreview",
    },
  },
  {
    "context": "Editor && extension == md",
    "unbind": {
      "ctrl-shift-v": "markdown::OpenPreview",
    },
  },
  {
    "context": "!AcpThread > Editor && mode == full",
    "unbind": {
      "ctrl-enter": "assistant::InlineAssist",
    },
  },
  {
    "context": "Editor && edit_prediction",
    "bindings": {
      "alt-right": "editor::AcceptEditPrediction",
    },
    "unbind": {
      "alt-l": "editor::AcceptEditPrediction",
    },
  },
  {
    "context": "Editor && showing_completions",
    "bindings": {
      "ctrl-space": "editor::Cancel",
      "alt-shift-space": "editor::Cancel",
    },
  },
  {
    "context": "GitDiff > Editor",
    "bindings": {
      "ctrl-space": "git::StageAndNext",
    },
    "unbind": {
      "ctrl-space": "git::StageAll",
      "ctrl-shift-space": "git::UnstageAll",
    },
  },
  {
    "context": "GitPanel",
    "unbind": {
      "ctrl-shift-space": "git::UnstageAll",
    },
  },
  {
    "context": "SettingsWindow",
    "bindings": {
      "ctrl-q": "workspace::CloseWindow",
    },
    "unbind": {
      "ctrl-w": "workspace::CloseWindow",
    },
  },
  {
    "context": "RulesLibrary",
    "bindings": {
      "ctrl-q": "workspace::CloseWindow",
    },
    "unbind": {
      "ctrl-w": "workspace::CloseWindow",
    },
  },
  {
    "context": "Pane",
    "unbind": {
      "ctrl-w": ["pane::CloseActiveItem", { "close_pinned": false }],
    },
  },
  {
    "context": "Workspace",
    "unbind": {
      "ctrl-shift-r": [
        "task::Rerun",
        {
          "reevaluate_context": false
        }
      ]
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-shift-r": "projects::OpenRecent"
    }
  },
  {
    "context": "Workspace",
    "unbind": {
      "ctrl-r": "projects::OpenRecent"
    }
  },
  {
    "context": "Editor && mode == full",
    "bindings": {
      "ctrl-r": "buffer_search::DeployReplace"
    }
  },
  {
    "context": "Editor && mode == full",
    "unbind": {
      "ctrl-h": "buffer_search::DeployReplace"
    }
  },
  {
    "context": "BufferSearchBar",
    "bindings": {
      "ctrl-r": "search::ToggleReplace"
    }
  },
  {
    "context": "BufferSearchBar",
    "unbind": {
      "ctrl-h": "search::ToggleReplace"
    }
  },
  {
    "context": "Editor && edit_prediction",
    "bindings": {
      "ctrl-alt-right": "editor::AcceptNextWordEditPrediction"
    }
  },
  {
    "context": "Editor && edit_prediction",
    "unbind": {
      "alt-k": "editor::AcceptNextWordEditPrediction"
    }
  }
]
