// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "unbind": {
      "ctrl-q": "zed::Quit",
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      // "shift shift": "file_finder::Toggle"
    },
    "unbind": {
      "ctrl-w": "workspace::CloseActiveDock",
    },
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      // "j k": "vim::NormalBefore"
    },
  },
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-shift-enter": "pane::SplitRight",
      "ctrl-shift-q": [
        "pane::CloseActiveItem",
        {
          "close_pinned": false,
        },
      ],
    },
    "unbind": {
      "ctrl-shift-5": "pane::SplitRight",
      "ctrl-shift-space": "terminal::ToggleViMode",
      "ctrl-shift-c": "collab_panel::ToggleFocus",
    },
  },
  {
    "context": "Editor",
    "bindings": {
      "ctrl-shift-enter": "pane::SplitRight",
      "ctrl-shift-c": "editor::Copy",
      "ctrl-shift-v": "editor::Paste",
      "ctrl-q": [
        "pane::CloseActiveItem",
        {
          "close_pinned": false,
        },
      ],
    },
    "unbind": {
      "ctrl-\\": "pane::SplitRight",
    },
  },
  {
    "context": "Editor && mode == full",
    "unbind": {
      "ctrl-shift-enter": "editor::NewlineAbove",
    },
  },
  {
    "context": "Editor && mode == auto_height",
    "unbind": {
      "ctrl-shift-enter": "editor::NewlineBelow",
    },
  },
  {
    "context": "Editor && extension == svg",
    "unbind": {
      "ctrl-shift-v": "svg::OpenPreview",
    },
  },
  {
    "context": "Editor && extension == md",
    "unbind": {
      "ctrl-shift-v": "markdown::OpenPreview",
    },
  },
  {
    "context": "!AcpThread > Editor && mode == full",
    "unbind": {
      "ctrl-enter": "assistant::InlineAssist",
    },
  },
  {
    "context": "Editor && edit_prediction",
    "bindings": {
      "alt-right": "editor::AcceptEditPrediction",
    },
    "unbind": {
      "alt-l": "editor::AcceptEditPrediction",
    },
  },
  {
    "context": "SettingsWindow",
    "bindings": {
      "ctrl-q": "workspace::CloseWindow",
    },
    "unbind": {
      "ctrl-w": "workspace::CloseWindow",
    },
  },
  {
    "context": "RulesLibrary",
    "bindings": {
      "ctrl-q": "workspace::CloseWindow",
    },
    "unbind": {
      "ctrl-w": "workspace::CloseWindow",
    },
  },
  {
    "context": "Pane",
    "unbind": {
      "ctrl-w": [
        "pane::CloseActiveItem",
        {
          "close_pinned": false,
        },
      ],
    },
  },
]
