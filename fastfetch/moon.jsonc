{
    "$schema": "https://raw.githubusercontent.com/fastfetch-cli/fastfetch/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/profilepic.png",
        "type": "kitty",
        "width":30,
        "padding": {
            "top": 1,
            "left": 2
        }
    },
    "display": {
        "separator": " ",
        "size": {
            "maxPrefix": "GB",
            "ndigits": 1
        }
    },
    "modules": [
        "break",
        "break",
        {
            "type": "title",
            "keyWidth": 10
        },
        {
            "type": "custom",
            "format": "{#35}┄╼━━━━━━━━━╾┄{#}"
        },
        {
            "type": "os",
            "key": " ",
            "keyColor": "blue"
        },
        {
            "type": "host",
            "key": "󰌢 ",
            "keyColor": "blue",
            "format": "{vendor} {name}"
        },
        {
            "type": "uptime",
            "key": " ",
            "keyColor": "blue"
        },
        {
            "type": "kernel",
            "key": " ",
            "keyColor": "blue"
        },
        {
            "type": "packages",
            "format": "{pacman} (pacman)",
            "key": " ",
            "keyColor": "blue"
        },
        {
            "type": "shell",
            "key": " ",
            "keyColor": "blue"
        },
        {
            "type": "terminal",
            "key": " ",
            "keyColor": "blue"
        },
        {
            "type": "wm",
            "key": " ",
            "keyColor": "blue"
        },
        {
            "type": "terminalfont",
            "key": " ",
            "keyColor": "blue"
        },
        "break",
        {
            "type": "cpu",
            "key": " ",
            "keyColor": "blue",
            "format": "{name}"
        },
        {
            "type": "gpu",
            "key": " ",
            "keyColor": "blue",
            "format": "{name} {driver} [{type}]"
        },
        {
            "type": "memory",
            "key": " ",
            "keyColor": "blue",
            "format": "{used} / {total} {percentage}"
        },
        {
            "type": "display",
            "key": "🖵 ",
            "keyColor": "blue",
            "compactType": "original"
        },
        {
            "type": "battery",
            "key": " ",
            "keyColor": "blue",
            "format": "{/capacity}{-}{/}{capacity}{?status} [{status}]{?}"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[1;30m  \u001b[1;31m  \u001b[1;32m  \u001b[1;33m  \u001b[1;34m  \u001b[1;35m  \u001b[1;36m  \u001b[1;37m "
        },
        {
            "type": "custom",
            "format": "\u001b[1;90m  \u001b[1;91m  \u001b[1;92m  \u001b[1;93m  \u001b[1;94m  \u001b[1;95m  \u001b[1;96m  \u001b[1;97m "
        }
    ]
}
