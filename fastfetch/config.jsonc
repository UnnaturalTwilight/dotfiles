{
    "$schema": "https://raw.githubusercontent.com/fastfetch-cli/fastfetch/dev/doc/json_schema.json",
    "display": {
        "size": {
            "maxPrefix": "GB",
            "ndigits": 1
        }
    },
    "modules": [
        "break",
        "title",
        {
            "type": "custom",
            "format": "{#35}┄╼━━━━━━━━━╾┄{#}"
        },
        "os",
        {
            "type": "host",
            "format": "{vendor} {/name}{-}{/}{name}"
        },
        {
            "type": "kernel",
            "format": "{release}"
        },
        "uptime",
        "packages",
        "shell",
        {
            "type": "display",
            "compactType": "original",
            "key": "Resolution"
        },
        "de",
        "wm",
        "wmtheme",
        "theme",
        "icons",
        "terminal",
        {
            "type": "terminalfont",
            "format": "{/name}{-}{/}{name}{?size} ({size}pt){?}"
        },
        {
            "type": "cpu",
            "format": "{name}",
            "key": "CPU"
        },
        {
            "type": "gpu",
            "format": "{name} {driver} [{type}]",
            "key": "GPU"
        },
        {
            "type": "memory",
            "format": "{used} / {total} {percentage}",
            "key": "RAM"
        },
        {
            "type": "battery",
            "format": "{/capacity}{-}{/}{capacity}{?status} [{status}]{?}",
            "key": "Battery"
        },
        "break",
        "colors"
    ]
}
